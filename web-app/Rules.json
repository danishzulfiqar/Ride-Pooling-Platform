4.
{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "availability": {
          ".read": "$uid === auth.uid || root.child('riders').child(auth.uid).child('availability').val() === true"
        }
      }
    },
    "riders": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('bookings/' + $uid + '/rider').val() === auth.uid",
        ".write": "$uid === auth.uid",
        "availability": {
          ".read": "$uid === auth.uid || root.child('users').child(auth.uid).child('availability').val() === true"
        }
      }
    },
    "ridersAvailable": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid || auth != null",
        "userReq": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid || root.child('users').child(auth.uid).child('full_name').val() != null"
        }
      }
    },
    "Rides": {
      ".write": "auth != null",
      "active": {
        "$bid": {
          ".read": "root.child('riders').child(auth.uid).child('rides').child($bid).val() === true || root.child('users').child(auth.uid).child('rides').child($bid).val() === true || root.child('admin').child(auth.uid).child('admin').val() === true",
          ".write": "root.child('admin').child(auth.uid).child('admin').val() === true || root.child('riders').child(auth.uid).child('rides').child($bid).val() === true",
        }
      },
      "Non_active": {
        "$bid": {
          ".read": "root.child('riders').child(auth.uid).child('rides').child($bid).val() === true || root.child('users').child(auth.uid).child('rides').child($bid).val() === true || root.child('admin').child(auth.uid).child('admin').val() === true",
          ".write": "root.child('admin').child(auth.uid).child('admin').val() === true || root.child('riders').child(auth.uid).child('rides').child($bid).val() === true",
        }
      },
    },
    "admin": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    }
  }
}