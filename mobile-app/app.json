{
  "expo": {
    "name": "RidePool",
    "slug": "RidePool",
    "plugins": ["expo-font", "@react-native-firebase/app", "@react-native-firebase/auth"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ridepool.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Hicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ridepool.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.ridepool.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/ridepool.png"
    },
    "extra": {
      "eas": {
        "projectId": "7ecefd03-0c1e-4281-b27c-e3b23f30aacc"
      }
    }
  }
}
