{
  "expo": {
    "name": "RidePool",
    "slug": "ridepool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-mark.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-mark.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.ridepool.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/brand-mark.png"
    },
    "extra": {
      "eas": {
        "projectId": "7ecefd03-0c1e-4281-b27c-e3b23f30aacc"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
